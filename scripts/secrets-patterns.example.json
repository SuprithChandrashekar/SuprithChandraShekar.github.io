{
  "_note": "Copy this file to secrets-patterns.json (which is gitignored) and replace the patterns below with your real PII patterns. The redactor loads its rules from secrets-patterns.json — never from this example file — so your real patterns never leave your machine. Each entry is a JavaScript RegExp.",

  "patterns": [
    {
      "label": "phone-us",
      "pattern": "\\+?1?[\\s.-]?\\(?\\d{3}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}",
      "flags": "g",
      "replace": "[REDACTED-PHONE]"
    },
    {
      "label": "phone-mine",
      "pattern": "\\+?1?[\\s.-]?\\(?555\\)?[\\s.-]?555[\\s.-]?5555",
      "flags": "g",
      "replace": "[REDACTED-PHONE]"
    },
    {
      "label": "email-personal",
      "pattern": "your\\.real\\.email@example\\.com",
      "flags": "gi",
      "replace": "[REDACTED-EMAIL]"
    },
    {
      "label": "email-school",
      "pattern": "yourname\\d*@yourschool\\.edu",
      "flags": "gi",
      "replace": "[REDACTED-EMAIL]"
    },
    {
      "label": "street-address",
      "pattern": "\\d{1,5} [A-Z][a-zA-Z]+ (Ave|St|Street|Avenue|Rd|Road|Blvd|Drive|Dr|Lane|Ln)",
      "flags": "g",
      "replace": "[REDACTED-ADDRESS]"
    }
  ]
}
